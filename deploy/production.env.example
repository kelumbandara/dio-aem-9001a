# Production settings for one customer. Copy to production.env (git-ignored) or enter each line in Coolify's secret store.
# `php artisan app:preflight` (run automatically at start) refuses to start the app if the unsafe ones are wrong.
# Generate APP_KEY once:  docker run --rm dio-erp:<release> artisan key:generate --show   (keep it: losing it makes encrypted data unreadable)

APP_NAME="DIO ERP"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://erp.customer.example.lk
APP_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Behind Coolify/Traefik: trust the proxy in front (it is the only way in). HSTS tells browsers to insist on https.
TRUSTED_PROXIES=*
HSTS_SECONDS=31536000

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=dio_erp
DB_USERNAME=dio_erp
DB_PASSWORD=
# Use "require" when the database is on another host.
DB_SSLMODE=prefer

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
QUEUE_CONNECTION=redis
CACHE_STORE=redis

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
SESSION_LIFETIME=120

# E-mail (Hostinger example): the mailbox password goes only here.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="DIO Solutions"

# Files (attachments, logos): object storage, so a rebuilt container loses nothing.
ATTACHMENTS_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# For non-AWS storage (Wasabi, MinIO, Hostinger Object Storage …):
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=true

# Virus scan of uploads (the clamav service of the stack).
CLAMAV_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Passwords found in known breaches are refused (needs outbound access to api.pwnedpasswords.com).
PASSWORD_CHECK_BREACHED=true

# Licensing (from the vendor billing system).
LICENCE_PUBLIC_KEY=
VENDOR_BILLING_URL=
VENDOR_BILLING_TOKEN=

# AI assistant and WhatsApp: leave empty until the customer has the accounts.
# ANTHROPIC_API_KEY=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=

# Backup sidecar (only the compose file reads these)
BACKUP_PASSPHRASE=
# BACKUP_S3_URI=s3://bucket/dio-erp/
